     }
   }
 
+  /**
+   * Marks the game as finished with the given winner (null = draw). Used for time-limit
+   * decisions (regular-time crowns, overtime crowns, overtime tower-health tiebreaker),
+   * which previously only marked the Match — making the bridge reward/telemetry report
+   * them as draws even though a winner was decided.
+   */
+  public void markFinished(Team winner) {
+    this.gameOver = true;
+    this.winner = winner;
+  }
