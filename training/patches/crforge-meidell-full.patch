+def _check_binary_obs(obs) -> None:
+    """Catch a stale bridge build on the FIRST reset instead of mid-rollout.
+
+    A stale gym-bridge JVM serves a different observation width (e.g. 1079 vs
+    1094 floats) and training would otherwise die later with a cryptic
+    mat1/mat2 shape error. Runs per worker on every reset, so the failure is
+    immediate and actionable. Only checks flat float32 vectors (binary mode);
+    dict observations (JSON mode) are skipped.
+    """
+    if isinstance(obs, np.ndarray) and obs.ndim == 1 and obs.shape[0] != _EXPECTED_OBS_SIZE:
+        raise RuntimeError(
+            f"Bridge served {obs.shape[0]}-float observations but this code expects "
+            f"{_EXPECTED_OBS_SIZE}. The Java bridge build is STALE. Rebuild it and "
+            "restart the run:\n"
+            "  Windows:  ./gradlew.bat :gym-bridge:installDist  "
+            "(then kill orphans: taskkill /IM java.exe /F)\n"
+            "  Linux:    ./gradlew :gym-bridge:installDist      "
+            "(then kill orphans: pkill -f gym-bridge)"
+        )
+
 
