+def _parse_sequential_numpy(seq) -> list:
+    """Convert a torch Sequential (Linear/ReLU/Tanh) into a list of numpy ops.
+
+    Detects the actual modules instead of assuming an activation -- the pool12
+    checkpoint lineage uses Tanh while SB3's default is ReLU.
+    """
+    import torch.nn as nn
+
+    modules = list(seq) if isinstance(seq, nn.Sequential) else [seq]
+    ops = []
+    for m in modules:
+        if isinstance(m, nn.Linear):
+            w = m.weight.detach().cpu().numpy().astype(np.float32)
+            b = (m.bias.detach().cpu().numpy().astype(np.float32)
+                 if m.bias is not None else None)
+
+            def _lin(x, w=w, b=b):
+                y = x @ w.T
+                if b is not None:
+                    y = y + b
+                return y
+
+            ops.append(_lin)
+        elif isinstance(m, nn.ReLU):
+            ops.append(lambda x: np.maximum(x, 0, out=x))
+        elif isinstance(m, nn.Tanh):
+            ops.append(np.tanh)
+        else:
+            raise ValueError(f"unsupported module in policy net: {type(m).__name__}")
+    return ops
