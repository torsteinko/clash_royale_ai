+class _FastNumpyPolicy:
+    """Numpy forward of the MaskablePPO MLP for fast opponent inference.
+
+    Mirrors the model's actual module layout (Linear/ReLU/Tanh are detected,
+    not assumed) and the same masked categorical sampling semantics as
+    model.predict(..., deterministic=False); only the RNG source differs
+    (numpy instead of torch). Speeds up opponent action selection only --
+    the sim and env logic are untouched.
+    """
+
+    def __init__(self, model):
+        policy = model.policy
+        # Parse the actual Sequential layout (detect activations instead of assuming).
+        self.pi_ops = _parse_sequential_numpy(policy.mlp_extractor.policy_net)
+        self.action_ops = _parse_sequential_numpy(policy.action_net)
+        self.nvec = None
+        nvec = getattr(policy.action_space, "nvec", None)
+        if nvec is None:
+            raise ValueError("expected a MultiDiscrete action space")
+        self.nvec = [int(n) for n in nvec]
+
+    def logits(self, x: np.ndarray) -> np.ndarray:
+        """Forward pass; x is (n, obs_dim) float32 -> (n, sum(nvec)) logits."""
+        h = np.array(x, dtype=np.float32)  # copy: activations may work in place
+        for op in self.pi_ops:
+            h = op(h)
+        for op in self.action_ops:
+            h = op(h)
+        return h
+
+    def _sample_head(self, head: np.ndarray, head_mask: np.ndarray, size: int,
+                     rng: np.random.Generator) -> int:
+        h = head.copy()
+        h[~head_mask] = -np.inf
+        finite = np.isfinite(h)
+        if not finite.any():
+            return 0  # fully masked head: only reachable for hand/zone of a noop
+        mx = h[finite].max()
+        p = np.exp(h - mx)
+        p[~finite] = 0.0
+        s = p.sum()
+        if not np.isfinite(s) or s <= 0:
+            return int(np.argmax(finite))
+        return int(rng.choice(size, p=p / s))
+
+    def sample(self, obs: np.ndarray, mask: np.ndarray,
+               rng: np.random.Generator) -> np.ndarray:
+        """Masked categorical sample for one observation (same semantics as the model)."""
+        logits = self.logits(obs[None, :])[0]
+        out = np.zeros(len(self.nvec), dtype=np.int64)
+        off = 0
+        for j, d in enumerate(self.nvec):
+            out[j] = self._sample_head(logits[off:off + d], mask[off:off + d], d, rng)
+            off += d
+        return out
+
+    def sample_batch(self, obs_batch: np.ndarray, mask_batch: np.ndarray,
+                     rng: np.random.Generator) -> np.ndarray:
+        """Batched masked sampling: (K, obs) + (K, mask) -> (K, n_heads)."""
+        all_logits = self.logits(np.asarray(obs_batch, dtype=np.float32))
+        outs = np.zeros((all_logits.shape[0], len(self.nvec)), dtype=np.int64)
+        for i in range(all_logits.shape[0]):
+            off = 0
+            for j, d in enumerate(self.nvec):
+                outs[i, j] = self._sample_head(all_logits[i, off:off + d],
+                                               mask_batch[i, off:off + d], d, rng)
+                off += d
+        return outs
 
 
